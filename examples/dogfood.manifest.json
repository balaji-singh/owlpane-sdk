{
  "description": "One Owlpane console project (and ingest key) per app — same as customer onboarding.",
  "apps": [
    {
      "id": "node",
      "project": "owlpane-sdk-node",
      "dir": "apps/node",
      "ingestKeyEnv": "OWLPANE_INGEST_KEY_NODE"
    },
    {
      "id": "go",
      "project": "owlpane-sdk-go",
      "dir": "apps/go",
      "ingestKeyEnv": "OWLPANE_INGEST_KEY_GO"
    },
    {
      "id": "python",
      "project": "owlpane-sdk-python",
      "dir": "apps/python",
      "ingestKeyEnv": "OWLPANE_INGEST_KEY_PYTHON"
    },
    {
      "id": "java",
      "project": "owlpane-sdk-java",
      "dir": "apps/java",
      "ingestKeyEnv": "OWLPANE_INGEST_KEY_JAVA"
    },
    {
      "id": "ruby",
      "project": "owlpane-sdk-ruby",
      "dir": "apps/ruby",
      "ingestKeyEnv": "OWLPANE_INGEST_KEY_RUBY"
    }
  ]
}
