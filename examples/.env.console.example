# Copy to examples/.env and fill from Owlpane console (project ingest key + ingest URL).
# Used by sdk-*/run-console.sh and pii-canary/run.sh.

OWLPANE_INGEST_URL=http://127.0.0.1:4318
# From console → project → ingest key (must match owl_ing_ + 48 hex digits)
OWLPANE_INGEST_KEY=owl_ing_REPLACE_WITH_CONSOLE_KEY_48_HEX_CHARS________
OWLPANE_ENVIRONMENT=development
OTEL_SERVICE_NAME=owlpane-sdk-example

# Optional alias used by some samples:
# OWLPANE_ENDPOINT=http://127.0.0.1:4318
