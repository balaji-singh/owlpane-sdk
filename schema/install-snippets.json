{
  "version": 1,
  "go": {
    "module": "github.com/balaji-singh/owlpane-sdk/packages/go/owlpane",
    "goGet": "go get github.com/balaji-singh/owlpane-sdk/packages/go@v0.1.2",
    "env": [
      "OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.example.com",
      "OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf",
      "OWLPANE_INGEST_KEY=owl_ing_…",
      "OTEL_SERVICE_NAME=my-service",
      "OWLPANE_ENVIRONMENT=production"
    ],
    "code": "import \"github.com/balaji-singh/owlpane-sdk/packages/go/owlpane\"\n\nshutdown, err := owlpane.Start(context.Background(), nil)\n// … app …\n_ = shutdown(context.Background())"
  },
  "python": {
    "package": "owlpane",
    "pip": "pip install owlpane==0.1.2",
    "env": [
      "OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.example.com",
      "OWLPANE_INGEST_KEY=owl_ing_…",
      "OTEL_SERVICE_NAME=my-service",
      "OWLPANE_ENVIRONMENT=production"
    ]
  },
  "node": {
    "package": "@balaji-singh/owlpane-node",
    "npm": "npm install @balaji-singh/owlpane-node@0.1.2",
    "githubPackages": "https://npm.pkg.github.com",
    "note": "Hand-written full SDK; registry scope @balaji-singh on GitHub Packages."
  },
  "browser": {
    "package": "@balaji-singh/owlpane-browser",
    "npm": "npm install @balaji-singh/owlpane-browser@0.1.2",
    "githubPackages": "https://npm.pkg.github.com"
  },
  "java": {
    "package": "com.owlpane:owlpane-java",
    "maven": "com.owlpane:owlpane-java:0.1.2",
    "githubPackages": "https://maven.pkg.github.com/balaji-singh/owlpane-sdk",
    "env": [
      "OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.example.com",
      "OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf",
      "OWLPANE_INGEST_KEY=owl_ing_…",
      "OTEL_SERVICE_NAME=my-service"
    ],
    "note": "Use with OpenTelemetry Java agent; thin owlpane-java JAR on GitHub Packages Maven."
  },
  "ruby": {
    "package": "owlpane",
    "gem": "gem install owlpane -v 0.1.2",
    "githubPackages": "https://rubygems.pkg.github.com/balaji-singh",
    "env": [
      "OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.example.com",
      "OWLPANE_INGEST_KEY=owl_ing_…",
      "OTEL_SERVICE_NAME=my-service"
    ]
  }
}
